# =============================================
# HOSTINGER PRODUCTION ENVIRONMENT VARIABLES
# =============================================
# Is file ko .env.production naam se rakho
# Aur apni actual values se fill karo

# ---------------------------
# DATABASE (PostgreSQL)
# ---------------------------
# Option A: Hostinger ka PostgreSQL
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/DATABASE_NAME"
#
# Option B: Neon (Free External PostgreSQL) - Recommended
# DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"
#
# YAHAN APNA DATABASE URL DAALO:
DATABASE_URL="postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/YOUR_DB_NAME"

# ---------------------------
# AUTH SECRET
# ---------------------------
# Naya strong secret generate karo:
# Command: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="GENERATE_A_NEW_STRONG_SECRET_HERE"

# ---------------------------
# APP URL (Tumhara Domain)
# ---------------------------
NEXTAUTH_URL="https://yourdomain.com"
NEXT_PUBLIC_APP_URL="https://yourdomain.com"

# ---------------------------
# NODE ENVIRONMENT
# ---------------------------
NODE_ENV="production"
